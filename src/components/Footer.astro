<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <img src="/images/logo.png" alt="Instituto Tiago Fernandes" class="footer-logo" />
      <p class="footer-desc">
        Instituto Tiago Fernandes • Transformando famílias através da educação positiva, neurociência e respeito mútuo.
      </p>
    </div>

    <div class="footer-legal">
      <p>© {new Date().getFullYear()} Instituto Tiago Fernandes (ITF). Todos os direitos reservados.</p>
      <p class="footer-disclaimer">
        Este treinamento não substitui o acompanhamento de profissionais de saúde, neuropediatras ou psicólogos quando clinicamente indicado.
      </p>
      <div class="footer-links">
        <a href="#oferta">Termos de Uso</a> • <a href="#oferta">Políticas de Privacidade</a> • <a href="mailto:contato@lidereducacional.com">Suporte: contato@lidereducacional.com</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0F172A;
    color: #94A3B8;
    padding: 4rem 0 2.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.875rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  .footer-logo {
    height: 48px;
    width: auto;
    margin: 0 auto 1rem auto;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer-desc {
    max-width: 500px;
    color: #CBD5E1;
    font-size: 0.95rem;
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-width: 680px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
  }

  .footer-disclaimer {
    font-size: 0.775rem;
    color: #64748B;
    line-height: 1.5;
  }

  .footer-links {
    margin-top: 0.5rem;
  }

  .footer-links a {
    color: #38BDF8;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #7DD3FC;
    text-decoration: underline;
  }
</style>
