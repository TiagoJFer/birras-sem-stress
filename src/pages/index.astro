---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainDiagnostic from '../components/PainDiagnostic.astro';
import Mechanism from '../components/Mechanism.astro';
import Modules from '../components/Modules.astro';
import Testimonials from '../components/Testimonials.astro';
import BonusStack from '../components/BonusStack.astro';
import PricingOffer from '../components/PricingOffer.astro';
import Guarantee from '../components/Guarantee.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Elimine as Birras Sem Stress | Método do Redirecionamento Cognitivo"
  description="Desarme as birras do seu filho em menos de 5 minutos sem precisar bater, gritar ou viver com culpa. Método comprovado por mais de 3.500 famílias com Tiago Fernandes."
>
  <Header />
  <main>
    <Hero />
    <PainDiagnostic />
    <Mechanism />
    <Modules />
    <Testimonials />
    <BonusStack />
    <PricingOffer />
    <Guarantee />
    <AuthorBio />
    <FAQ />
  </main>
  <StickyCTA />
  <Footer />
</BaseLayout>
