---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainDiagnostic from '../components/PainDiagnostic.astro';
import Mechanism from '../components/Mechanism.astro';
import Modules from '../components/Modules.astro';
import Testimonials from '../components/Testimonials.astro';
import BonusStack from '../components/BonusStack.astro';
import PricingOffer from '../components/PricingOffer.astro';
import Guarantee from '../components/Guarantee.astro';
import AuthorBio from '../components/AuthorBio.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Catálogo de Templates e Componentes | Elimine as Birras">
  <div class="templates-admin-bar">
    <div class="container admin-bar-inner">
      <span>📐 <strong>Section Templates (Governança Sites com IA)</strong> — Visualização modular</span>
      <div class="admin-links">
        <a href="/" class="btn-live-view">Página Original →</a>
        <a href="/summer-splash" class="btn-live-view btn-summer">🌴 Opção 03: Summer Splash →</a>
      </div>
    </div>
  </div>

  <div class="template-divider"><span>COMPONENTE 01: HEADER</span></div>
  <Header />

  <div class="template-divider"><span>COMPONENTE 02: HERO SECTION</span></div>
  <Hero />

  <div class="template-divider"><span>COMPONENTE 03: DIAGNÓSTICO DE DORES & EMPATIA</span></div>
  <PainDiagnostic />

  <div class="template-divider"><span>COMPONENTE 04: MECANISMO NEUROCIENTÍFICO</span></div>
  <Mechanism />

  <div class="template-divider"><span>COMPONENTE 05: MÓDULOS DO CURSO</span></div>
  <Modules />

  <div class="template-divider"><span>COMPONENTE 06: DEPOIMENTOS & AUDIO PLAYER</span></div>
  <Testimonials />

  <div class="template-divider"><span>COMPONENTE 07: STACK DE BÔNUS</span></div>
  <BonusStack />

  <div class="template-divider"><span>COMPONENTE 08: OFERTA & PRICING</span></div>
  <PricingOffer />

  <div class="template-divider"><span>COMPONENTE 09: GARANTIA DE 7 DIAS</span></div>
  <Guarantee />

  <div class="template-divider"><span>COMPONENTE 10: BIOGRAFIA DO ESPECIALISTA</span></div>
  <AuthorBio />

  <div class="template-divider"><span>COMPONENTE 11: FAQ ACORDEÃO</span></div>
  <FAQ />

  <div class="template-divider"><span>COMPONENTE 12: FOOTER</span></div>
  <Footer />
</BaseLayout>

<style>
  .templates-admin-bar {
    background: #0284C7;
    color: #FFFFFF;
    padding: 0.75rem 0;
    font-size: 0.875rem;
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: var(--shadow-md);
  }

  .admin-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .admin-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .btn-live-view {
    background: #FFFFFF;
    color: #0284C7;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    font-size: 0.8125rem;
  }

  .btn-summer {
    background: #DCFCE7;
    color: #15803D;
    border: 1px solid #86EFAC;
  }

  .btn-summer:hover {
    background: #16A34A;
    color: #FFFFFF;
  }

  .btn-live-view:hover {
    background: #F0FDF4;
    color: #10B981;
  }

  .template-divider {
    background: #E2E8F0;
    text-align: center;
    padding: 0.5rem 0;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748B;
    border-top: 1px solid #CBD5E1;
    border-bottom: 1px solid #CBD5E1;
  }
</style>
